rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }
    function authorized() {
      return signedIn()
        && exists(userPath())
        && get(userPath()).data.activo == true;
    }
    function myId() { return get(userPath()).data.hermanoId; }
    function roleIs(role) { return authorized() && get(userPath()).data.role == role; }
    function secretary() { return roleIs('secretaria'); }
    function treasurer() { return roleIs('tesoreria'); }
    function president() { return roleIs('presidencia'); }
    function rosterReader() { return secretary() || president(); }
    function financeReader() { return treasurer() || president(); }

    match /usuarios/{uid} {
      allow get: if authorized() && request.auth.uid == uid;
      allow list: if president();
      allow create, update, delete: if false;
    }

    match /hermanos/{memberId} {
      allow get: if authorized() && (memberId == myId() || rosterReader());
      allow list: if rosterReader();
      // Roster managers may create a complete member record, never a user account.
      allow create: if rosterReader()
        && request.resource.data.keys().hasOnly([
          'fullName', 'dni', 'birthDate', 'address', 'phone', 'email',
          'occupation', 'maritalStatus', 'joinedAt', 'swornAt', 'category',
          'status', 'sacraments', 'photoUrl', 'guardian', 'retiredAt',
          'rejoinedAt', 'createdAt', 'updatedAt', 'createdAtServer',
          'updatedAtServer', 'createdBy'
        ])
        && request.resource.data.keys().hasAll([
          'fullName', 'dni', 'birthDate', 'address', 'phone', 'email',
          'occupation', 'maritalStatus', 'joinedAt', 'swornAt', 'category',
          'status', 'sacraments', 'photoUrl', 'guardian', 'retiredAt',
          'rejoinedAt', 'createdAt', 'updatedAt', 'createdAtServer',
          'updatedAtServer', 'createdBy'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 5
        && request.resource.data.fullName.size() <= 160
        && request.resource.data.dni is string
        && (request.resource.data.dni == '' || request.resource.data.dni.size() == 8)
        && (request.resource.data.dni == '' || memberId == 'dni-' + request.resource.data.dni)
        && request.resource.data.birthDate is string
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 300
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.occupation is string
        && request.resource.data.occupation.size() <= 150
        && request.resource.data.maritalStatus is string
        && request.resource.data.maritalStatus.size() <= 80
        && request.resource.data.joinedAt is string
        && request.resource.data.swornAt is string
        && request.resource.data.category in ['postulante', 'reingresante', 'activo', 'vitalicio']
        && request.resource.data.status == 'vigente'
        && request.resource.data.sacraments is list
        && request.resource.data.sacraments.size() <= 10
        && request.resource.data.photoUrl == null
        && (request.resource.data.guardian == null || (
          request.resource.data.guardian is map
          && request.resource.data.guardian.keys().hasOnly([
            'fullName', 'dni', 'education', 'address', 'phone', 'relationship', 'age', 'sacraments'
          ])
          && request.resource.data.guardian.keys().hasAll([
            'fullName', 'dni', 'education', 'address', 'phone', 'relationship', 'age', 'sacraments'
          ])
          && request.resource.data.guardian.fullName is string
          && request.resource.data.guardian.fullName.size() >= 3
          && request.resource.data.guardian.fullName.size() <= 160
          && request.resource.data.guardian.dni is string
          && (request.resource.data.guardian.dni == '' || request.resource.data.guardian.dni.size() == 8)
          && request.resource.data.guardian.education is string
          && request.resource.data.guardian.education.size() <= 100
          && request.resource.data.guardian.address is string
          && request.resource.data.guardian.address.size() <= 300
          && request.resource.data.guardian.phone is string
          && request.resource.data.guardian.phone.size() <= 30
          && request.resource.data.guardian.relationship is string
          && request.resource.data.guardian.relationship.size() <= 80
          && request.resource.data.guardian.age is string
          && request.resource.data.guardian.age.size() <= 3
          && request.resource.data.guardian.sacraments is list
          && request.resource.data.guardian.sacraments.size() <= 10
        ))
        && request.resource.data.retiredAt == ''
        && request.resource.data.rejoinedAt == ''
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt == request.resource.data.createdAt
        && request.resource.data.createdAtServer == request.time
        && request.resource.data.updatedAtServer == request.time
        && request.resource.data.createdBy == request.auth.uid;

      // Contact details only; lifecycle and category changes need an audited workflow.
      allow update: if rosterReader()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'address', 'phone', 'email', 'occupation', 'maritalStatus',
          'sacraments', 'guardian', 'updatedAt', 'updatedAtServer'
        ])
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 300
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.occupation is string
        && request.resource.data.occupation.size() <= 150
        && request.resource.data.maritalStatus is string
        && request.resource.data.maritalStatus.size() <= 80
        && request.resource.data.sacraments is list
        && request.resource.data.sacraments.size() <= 10
        && (request.resource.data.guardian == null || (
          request.resource.data.guardian is map
          && request.resource.data.guardian.keys().hasOnly([
            'fullName', 'dni', 'education', 'address', 'phone', 'relationship', 'age', 'sacraments'
          ])
          && request.resource.data.guardian.keys().hasAll([
            'fullName', 'dni', 'education', 'address', 'phone', 'relationship', 'age', 'sacraments'
          ])
          && request.resource.data.guardian.fullName is string
          && request.resource.data.guardian.fullName.size() >= 3
          && request.resource.data.guardian.fullName.size() <= 160
          && request.resource.data.guardian.dni is string
          && (request.resource.data.guardian.dni == '' || request.resource.data.guardian.dni.size() == 8)
          && request.resource.data.guardian.education is string
          && request.resource.data.guardian.education.size() <= 100
          && request.resource.data.guardian.address is string
          && request.resource.data.guardian.address.size() <= 300
          && request.resource.data.guardian.phone is string
          && request.resource.data.guardian.phone.size() <= 30
          && request.resource.data.guardian.relationship is string
          && request.resource.data.guardian.relationship.size() <= 80
          && request.resource.data.guardian.age is string
          && request.resource.data.guardian.age.size() <= 3
          && request.resource.data.guardian.sacraments is list
          && request.resource.data.guardian.sacraments.size() <= 10
        ))
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAtServer == request.time;
      // Secretary-only category transition paired with an immutable history event.
      allow update: if secretary()
        && resource.data.status == 'vigente'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'category', 'updatedAt', 'updatedAtServer', 'lastCategoryEventId'
        ])
        && request.resource.data.category in ['postulante','reingresante','activo','vitalicio']
        && request.resource.data.category != resource.data.category
        && request.resource.data.lastCategoryEventId is string
        && request.resource.data.lastCategoryEventId.size() >= 10
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() == 10
        && request.resource.data.updatedAtServer == request.time
        && getAfter(/databases/$(database)/documents/historialInstitucional/$(request.resource.data.lastCategoryEventId)).data.hermanoId == memberId
        && getAfter(/databases/$(database)/documents/historialInstitucional/$(request.resource.data.lastCategoryEventId)).data.fromCategory == resource.data.category
        && getAfter(/databases/$(database)/documents/historialInstitucional/$(request.resource.data.lastCategoryEventId)).data.category == request.resource.data.category
        && getAfter(/databases/$(database)/documents/historialInstitucional/$(request.resource.data.lastCategoryEventId)).data.recordedBy == request.auth.uid;
      // Retirement/readmission must commit an immutable matching event atomically.
      allow update: if secretary()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status','category','retiredAt','rejoinedAt','updatedAt','updatedAtServer','lastLifecycleEventId'
        ])
        && request.resource.data.lastLifecycleEventId is string
        && request.resource.data.lastLifecycleEventId.size() >= 10
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() == 10
        && request.resource.data.updatedAtServer == request.time
        && (
          (resource.data.status == 'vigente'
            && request.resource.data.status == 'retirado'
            && request.resource.data.category == resource.data.category
            && request.resource.data.retiredAt == request.resource.data.updatedAt
            && request.resource.data.rejoinedAt == resource.data.rejoinedAt)
          ||
          (resource.data.status == 'retirado'
            && request.resource.data.status == 'vigente'
            && request.resource.data.category == 'reingresante'
            && request.resource.data.rejoinedAt == request.resource.data.updatedAt
            && request.resource.data.retiredAt == resource.data.retiredAt)
        )
        && getAfter(/databases/$(database)/documents/historialInstitucional/$(request.resource.data.lastLifecycleEventId)).data.hermanoId == memberId
        && getAfter(/databases/$(database)/documents/historialInstitucional/$(request.resource.data.lastLifecycleEventId)).data.fromStatus == resource.data.status
        && getAfter(/databases/$(database)/documents/historialInstitucional/$(request.resource.data.lastLifecycleEventId)).data.status == request.resource.data.status
        && getAfter(/databases/$(database)/documents/historialInstitucional/$(request.resource.data.lastLifecycleEventId)).data.fromCategory == resource.data.category
        && getAfter(/databases/$(database)/documents/historialInstitucional/$(request.resource.data.lastLifecycleEventId)).data.category == request.resource.data.category
        && getAfter(/databases/$(database)/documents/historialInstitucional/$(request.resource.data.lastLifecycleEventId)).data.recordedBy == request.auth.uid;
      allow delete: if false;
    }

    match /movimientos/{movementId} {
      allow get, list: if financeReader()
        || (authorized() && resource.data.memberId == myId());
      // Own-state-of-account queries MUST filter by memberId.
      allow create, update, delete: if false;
    }

    match /solicitudes/{requestId} {
      allow get, list: if secretary()
        || (authorized() && resource.data.requesterId == myId());

      allow create: if authorized()
        && !secretary()
        && request.resource.data.keys().hasOnly([
          'requesterId', 'title', 'content', 'status', 'submittedAt',
          'updatedAt', 'createdAtServer', 'updatedAtServer'
        ])
        && request.resource.data.keys().hasAll([
          'requesterId', 'title', 'content', 'status', 'submittedAt',
          'updatedAt', 'createdAtServer'
        ])
        && request.resource.data.requesterId == myId()
        && request.resource.data.status == 'enviada'
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 10
        && request.resource.data.content.size() <= 5000
        && request.resource.data.submittedAt is string
        && request.resource.data.submittedAt.size() == 10
        && request.resource.data.updatedAt == request.resource.data.submittedAt
        && request.resource.data.createdAtServer == request.time
        && request.resource.data.updatedAtServer == request.time;

      allow update: if secretary()
        && resource.data.status in ['enviada', 'en_revision', 'derivada']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'updatedAtServer'])
        && request.resource.data.status in ['en_revision', 'derivada', 'resuelta']
        && request.resource.data.status != resource.data.status
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() == 10
        && request.resource.data.updatedAtServer == request.time;
      allow delete: if false;
    }

    match /historialInstitucional/{eventId} {
      allow get, list: if rosterReader();
      allow create: if secretary()
        && request.resource.data.keys().hasOnly([
          'hermanoId','type','fromCategory','category','date','reason',
          'recordedBy','createdAt','createdAtServer'
        ])
        && request.resource.data.keys().hasAll([
          'hermanoId','type','fromCategory','category','date','reason',
          'recordedBy','createdAt','createdAtServer'
        ])
        && request.resource.data.hermanoId is string
        && request.resource.data.type == 'cambio_categoria'
        && request.resource.data.fromCategory in ['postulante','reingresante','activo','vitalicio']
        && request.resource.data.category in ['postulante','reingresante','activo','vitalicio']
        && request.resource.data.category != request.resource.data.fromCategory
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && request.resource.data.reason.size() <= 500
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.createdAt == request.resource.data.date
        && request.resource.data.createdAtServer == request.time
        && getAfter(/databases/$(database)/documents/hermanos/$(request.resource.data.hermanoId)).data.lastCategoryEventId == eventId
        && getAfter(/databases/$(database)/documents/hermanos/$(request.resource.data.hermanoId)).data.category == request.resource.data.category;
      allow create: if secretary()
        && request.resource.data.keys().hasOnly([
          'hermanoId','type','fromStatus','status','fromCategory','category',
          'date','reason','recordedBy','createdAt','createdAtServer'
        ])
        && request.resource.data.keys().hasAll([
          'hermanoId','type','fromStatus','status','fromCategory','category',
          'date','reason','recordedBy','createdAt','createdAtServer'
        ])
        && request.resource.data.hermanoId is string
        && request.resource.data.type in ['retiro','reingreso']
        && request.resource.data.fromStatus in ['vigente','retirado']
        && request.resource.data.status in ['vigente','retirado']
        && (
          (request.resource.data.type == 'retiro'
            && request.resource.data.fromStatus == 'vigente'
            && request.resource.data.status == 'retirado'
            && request.resource.data.category == request.resource.data.fromCategory)
          ||
          (request.resource.data.type == 'reingreso'
            && request.resource.data.fromStatus == 'retirado'
            && request.resource.data.status == 'vigente'
            && request.resource.data.category == 'reingresante')
        )
        && request.resource.data.fromCategory in ['postulante','reingresante','activo','vitalicio']
        && request.resource.data.category in ['postulante','reingresante','activo','vitalicio']
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && request.resource.data.reason.size() <= 500
        && request.resource.data.recordedBy == request.auth.uid
        && request.resource.data.date is string
        && request.resource.data.date.size() == 10
        && request.resource.data.createdAt == request.resource.data.date
        && request.resource.data.createdAtServer == request.time
        && getAfter(/databases/$(database)/documents/hermanos/$(request.resource.data.hermanoId)).data.lastLifecycleEventId == eventId
        && getAfter(/databases/$(database)/documents/hermanos/$(request.resource.data.hermanoId)).data.status == request.resource.data.status
        && getAfter(/databases/$(database)/documents/hermanos/$(request.resource.data.hermanoId)).data.category == request.resource.data.category;
      allow update, delete: if false;
    }

    match /configuracionEconomica/{documentId} {
      allow get, list: if treasurer() || president();
      allow create, update, delete: if false;
    }

    match /configuracion/{configId} {
      allow get, list: if secretary() || president();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
