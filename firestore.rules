rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function userPath() {
      return /databases/$(database)/documents/usuarios/$(request.auth.uid);
    }
    function authorized() {
      return signedIn()
        && exists(userPath())
        && get(userPath()).data.activo == true;
    }
    function myId() { return get(userPath()).data.hermanoId; }
    function roleIs(role) { return authorized() && get(userPath()).data.role == role; }
    function secretary() { return roleIs('secretaria'); }
    function treasurer() { return roleIs('tesoreria'); }
    function president() { return roleIs('presidencia'); }
    function rosterReader() { return secretary() || president(); }
    function financeReader() { return treasurer() || president(); }

    match /usuarios/{uid} {
      allow get: if authorized() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /hermanos/{memberId} {
      allow get: if authorized() && (memberId == myId() || rosterReader());
      allow list: if rosterReader();
      // Roster managers may create a complete member record, never a user account.
      allow create: if rosterReader()
        && request.resource.data.keys().hasOnly([
          'fullName', 'dni', 'birthDate', 'address', 'phone', 'email',
          'occupation', 'maritalStatus', 'joinedAt', 'swornAt', 'category',
          'status', 'sacraments', 'photoUrl', 'guardian', 'retiredAt',
          'rejoinedAt', 'createdAt', 'updatedAt', 'createdAtServer',
          'updatedAtServer', 'createdBy'
        ])
        && request.resource.data.keys().hasAll([
          'fullName', 'dni', 'birthDate', 'address', 'phone', 'email',
          'occupation', 'maritalStatus', 'joinedAt', 'swornAt', 'category',
          'status', 'sacraments', 'photoUrl', 'guardian', 'retiredAt',
          'rejoinedAt', 'createdAt', 'updatedAt', 'createdAtServer',
          'updatedAtServer', 'createdBy'
        ])
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 5
        && request.resource.data.fullName.size() <= 160
        && request.resource.data.dni is string
        && (request.resource.data.dni == '' || request.resource.data.dni.matches('^[0-9]{8}
    }

    match /movimientos/{movementId} {
      allow get, list: if financeReader()
        || (authorized() && resource.data.memberId == myId());
      // Own-state-of-account queries MUST filter by memberId.
      allow create, update, delete: if false;
    }

    match /solicitudes/{requestId} {
      allow get, list: if secretary()
        || (authorized() && resource.data.requesterId == myId());

      allow create: if authorized()
        && !secretary()
        && request.resource.data.keys().hasOnly([
          'requesterId', 'title', 'content', 'status', 'submittedAt',
          'updatedAt', 'createdAtServer', 'updatedAtServer'
        ])
        && request.resource.data.keys().hasAll([
          'requesterId', 'title', 'content', 'status', 'submittedAt',
          'updatedAt', 'createdAtServer'
        ])
        && request.resource.data.requesterId == myId()
        && request.resource.data.status == 'enviada'
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 10
        && request.resource.data.content.size() <= 5000
        && request.resource.data.submittedAt is string
        && request.resource.data.submittedAt.size() == 10
        && request.resource.data.updatedAt == request.resource.data.submittedAt
        && request.resource.data.createdAtServer == request.time
        && request.resource.data.updatedAtServer == request.time;

      allow update: if secretary()
        && resource.data.status in ['enviada', 'en_revision', 'derivada']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'updatedAtServer'])
        && request.resource.data.status in ['en_revision', 'derivada', 'resuelta']
        && request.resource.data.status != resource.data.status
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() == 10
        && request.resource.data.updatedAtServer == request.time;
      allow delete: if false;
    }

    match /historialInstitucional/{eventId} {
      allow get, list: if rosterReader();
      allow create, update, delete: if false;
    }

    match /configuracionEconomica/{documentId} {
      allow get, list: if treasurer() || president();
      allow create, update, delete: if false;
    }

    match /configuracion/{configId} {
      allow get, list: if secretary() || president();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
))
        && request.resource.data.birthDate is string
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 300
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.occupation is string
        && request.resource.data.occupation.size() <= 150
        && request.resource.data.maritalStatus is string
        && request.resource.data.maritalStatus.size() <= 80
        && request.resource.data.joinedAt is string
        && request.resource.data.swornAt is string
        && request.resource.data.category in ['postulante', 'reingresante', 'activo', 'vitalicio']
        && request.resource.data.status == 'vigente'
        && request.resource.data.sacraments is list
        && request.resource.data.sacraments.size() <= 10
        && request.resource.data.photoUrl == null
        && request.resource.data.guardian == null
        && request.resource.data.retiredAt == ''
        && request.resource.data.rejoinedAt == ''
        && request.resource.data.createdAt is string
        && request.resource.data.updatedAt == request.resource.data.createdAt
        && request.resource.data.createdAtServer == request.time
        && request.resource.data.updatedAtServer == request.time
        && request.resource.data.createdBy == request.auth.uid;

      // Contact details only; lifecycle and category changes need an audited workflow.
      allow update: if rosterReader()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'address', 'phone', 'email', 'occupation', 'maritalStatus',
          'updatedAt', 'updatedAtServer'
        ])
        && request.resource.data.address is string
        && request.resource.data.address.size() <= 300
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 30
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.occupation is string
        && request.resource.data.occupation.size() <= 150
        && request.resource.data.maritalStatus is string
        && request.resource.data.maritalStatus.size() <= 80
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAtServer == request.time;
      allow delete: if false;
    }

    match /movimientos/{movementId} {
      allow get, list: if financeReader()
        || (authorized() && resource.data.memberId == myId());
      // Own-state-of-account queries MUST filter by memberId.
      allow create, update, delete: if false;
    }

    match /solicitudes/{requestId} {
      allow get, list: if secretary()
        || (authorized() && resource.data.requesterId == myId());

      allow create: if authorized()
        && !secretary()
        && request.resource.data.keys().hasOnly([
          'requesterId', 'title', 'content', 'status', 'submittedAt',
          'updatedAt', 'createdAtServer', 'updatedAtServer'
        ])
        && request.resource.data.keys().hasAll([
          'requesterId', 'title', 'content', 'status', 'submittedAt',
          'updatedAt', 'createdAtServer'
        ])
        && request.resource.data.requesterId == myId()
        && request.resource.data.status == 'enviada'
        && request.resource.data.title is string
        && request.resource.data.title.size() >= 5
        && request.resource.data.title.size() <= 120
        && request.resource.data.content is string
        && request.resource.data.content.size() >= 10
        && request.resource.data.content.size() <= 5000
        && request.resource.data.submittedAt is string
        && request.resource.data.submittedAt.size() == 10
        && request.resource.data.updatedAt == request.resource.data.submittedAt
        && request.resource.data.createdAtServer == request.time
        && request.resource.data.updatedAtServer == request.time;

      allow update: if secretary()
        && resource.data.status in ['enviada', 'en_revision', 'derivada']
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt', 'updatedAtServer'])
        && request.resource.data.status in ['en_revision', 'derivada', 'resuelta']
        && request.resource.data.status != resource.data.status
        && request.resource.data.updatedAt is string
        && request.resource.data.updatedAt.size() == 10
        && request.resource.data.updatedAtServer == request.time;
      allow delete: if false;
    }

    match /historialInstitucional/{eventId} {
      allow get, list: if rosterReader();
      allow create, update, delete: if false;
    }

    match /configuracionEconomica/{documentId} {
      allow get, list: if treasurer() || president();
      allow create, update, delete: if false;
    }

    match /configuracion/{configId} {
      allow get, list: if secretary() || president();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
